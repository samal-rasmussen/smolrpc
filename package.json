{
	"name": "smolrpc",
	"version": "0.57.0",
	"description": "A smol typesafe rpc implementation over websockets",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/samal-rasmussen/smolrpc.git"
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"license": "MIT",
	"type": "module",
	"exports": {
		".": {
			"types": "./types/index.d.ts",
			"import": "./index.js"
		}
	},
	"files": [
		"authentication.md",
		"index.js",
		"src",
		"types"
	],
	"types": "./types/index.d.ts",
	"scripts": {
		"build": "dts-buddy && prettier --write types",
		"deno-server": "deno run --watch --allow-net examples/deno-server/index.ts",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"nodejs-client": "tsx --watch examples/nodejs-client/index.ts",
		"nodejs-server": "tsx --watch examples/nodejs-server/index.ts",
		"prepublishOnly": "npm run verify",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit",
		"verify": "npm run typecheck && npm run build && npm test && npm run lint && publint && npm pack --dry-run --json --ignore-scripts"
	},
	"dependencies": {
		"@standard-schema/spec": "1.0.0"
	},
	"devDependencies": {
		"@types/ws": "8.5.5",
		"@typescript-eslint/eslint-plugin": "6.7.5",
		"@typescript-eslint/parser": "6.7.5",
		"dts-buddy": "0.5.3",
		"eslint": "8.51.0",
		"eslint-config-prettier": "9.0.0",
		"eslint-plugin-simple-import-sort": "10.0.0",
		"prettier": "3.0.3",
		"publint": "0.2.0",
		"tsx": "4.19.2",
		"typescript": "5.5.4",
		"vitest": "4.1.11",
		"ws": "8.18.0",
		"zod": "4.0.14"
	}
}
